{
  "config": {
    "default": true,
    "line-length": false,
    "no-trailing-spaces": true,
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "no-multiple-blanks": {
      "maximum": 1
    },
    "no-hard-tabs": true,
    "single-title": {
      "level": 1,
      "front_matter_title": ""
    },
    "blanks-around-headings": {
      "lines_above": 1,
      "lines_below": 1
    },
    "blanks-around-lists": true,
    "list-marker-space": true,
    "ul-style": {
      "style": "dash"
    },
    "code-block-style": {
      "style": "fenced"
    },
    "fenced-code-language": true,
    "first-line-heading": true,
    "no-inline-html": false,
    // Tables are constitutional reading surfaces: keep columns aligned so the
    // source remains scannable without a Markdown renderer.
    "table-column-style": {
      "style": "aligned"
    }
  },
  "ignores": [
    // CLAUDE.md is the bridge to AGENTS.md: its first line is the `@AGENTS.md`
    // import, so MD041 can never pass there. AGENTS.md carries real content and
    // is linted like any other document.
    "CLAUDE.md",
    // Third-party text kept verbatim (Contributor Covenant 2.1, CC BY 4.0).
    // It uses `*` bullets where this project uses `-`; reformatting it would
    // have to be redone on every upstream version, so it is not linted.
    "CODE_OF_CONDUCT.md"
  ]
}
